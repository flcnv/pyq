# API
API_PORT=8000
LOG_LEVEL=INFO  # DEBUG also shows the live LLM extraction fingerprint
LOG_FORMAT=text  # json in production: one JSON object per line

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=
REDIS_PASSWORD=

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Uploads. Also limit the request body size at the reverse proxy / load balancer.
MAX_UPLOAD_MB=5
# Longer PDFs: the first pages and the last one are read, the rest is ignored
MAX_PDF_PAGES=10
# Larger pages are rendered at a lower dpi to stay within this many pixels
MAX_PDF_PAGE_PIXELS=25000000

# Rate limits
UPLOADS_PER_CLIENT_PER_MINUTE=20
LLM_REQUESTS_PER_CLIENT_PER_HOUR=10
LLM_REQUESTS_PER_DAY=200

# How long a file the LLM couldn't extract is remembered (not re-sent to Claude)
LLM_FAILURE_CACHE_TTL_SECONDS=86400

# Behind a load balancer: its addresses or subnet, never "*" (see README, deployment behind a proxy).
# Read by uvicorn from the process environment; docker compose passes this file through.
# FORWARDED_ALLOW_IPS=10.0.0.0/24

# Worker
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_SECONDS=2
JOB_RETRY_CAP_SECONDS=300
# Job lease = LLM_TIMEOUT_SECONDS * (LLM_MAX_RETRIES + 1) + this margin
JOB_LEASE_MARGIN_SECONDS=150
